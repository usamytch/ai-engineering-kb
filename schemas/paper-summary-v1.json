{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidb.local/schemas/paper-summary-v1.json",
  "title": "AIDB evidence-first paper summary v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
        "name": {"type": "string", "minLength": 1}
      },
      "required": ["code", "name"]
    },
    "labels": {"$ref": "#/$defs/render_labels"},
    "title": {"type": "string", "minLength": 1},
    "executive_summary": {"type": "string", "minLength": 40, "maxLength": 1200},
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "importance": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      },
      "required": ["statement", "importance", "scope"]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overview": {"type": "string", "minLength": 1},
        "key_components": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["overview", "key_components", "assumptions"]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "evidence": {"$ref": "#/$defs/evidence_list"}
        },
        "required": ["claim", "evidence"]
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {"type": "string", "minLength": 1},
          "context": {"type": "string", "minLength": 1},
          "evidence": {"$ref": "#/$defs/evidence_list"}
        },
        "required": ["result", "context", "evidence"]
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasets": {"type": "array", "items": {"$ref": "#/$defs/grounded_item"}},
        "baselines": {"type": "array", "items": {"$ref": "#/$defs/grounded_item"}},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/grounded_item"}},
        "ablations": {"type": "array", "items": {"$ref": "#/$defs/grounded_item"}},
        "negative_results": {"type": "array", "items": {"$ref": "#/$defs/grounded_item"}}
      },
      "required": ["datasets", "baselines", "metrics", "ablations", "negative_results"]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limitation": {"type": "string", "minLength": 1},
          "evidence": {"$ref": "#/$defs/evidence_list"}
        },
        "required": ["limitation", "evidence"]
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["strong", "partial", "weak", "unknown"]},
        "artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "missing": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assessment": {"type": "string", "minLength": 1}
      },
      "required": ["status", "artifacts", "missing", "assessment"]
    },
    "aidb_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "novelty": {"type": "string", "minLength": 1},
        "usefulness": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "recommended_action": {"type": "string", "enum": ["adopt", "watch", "read", "reject"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "required": ["novelty", "usefulness", "confidence", "recommended_action", "rationale"]
    },
    "uncertainties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uncertainty": {"type": "string", "minLength": 1},
          "why_it_matters": {"type": "string", "minLength": 1},
          "evidence": {"$ref": "#/$defs/evidence_list"}
        },
        "required": ["uncertainty", "why_it_matters", "evidence"]
      }
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "proposed_experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hypothesis": {"type": "string", "minLength": 1},
          "baseline": {"type": "string", "minLength": 1},
          "primary_metric": {"type": "string", "minLength": 1},
          "stop_condition": {"type": "string", "minLength": 1}
        },
        "required": ["hypothesis", "baseline", "primary_metric", "stop_condition"]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "string", "const": "paper-summary-v1"},
        "profile": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "minLength": 1},
        "document_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
        "metadata_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
        "block_count": {"type": "integer"},
        "repair_count": {"type": "integer"}
      },
      "required": ["schema_version", "profile", "provider", "generated_at", "document_sha256", "metadata_sha256", "block_count", "repair_count"]
    }
  },
  "required": ["language", "labels", "title", "executive_summary", "problem", "method", "claims", "results", "evaluation", "limitations", "reproducibility", "aidb_assessment", "uncertainties", "open_questions", "proposed_experiments", "provenance"],
  "$defs": {
    "render_label": {"type": "string", "minLength": 1, "maxLength": 80},
    "render_labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executive_summary": {"$ref": "#/$defs/render_label"},
        "problem": {"$ref": "#/$defs/render_label"},
        "statement": {"$ref": "#/$defs/render_label"},
        "importance": {"$ref": "#/$defs/render_label"},
        "scope": {"$ref": "#/$defs/render_label"},
        "method": {"$ref": "#/$defs/render_label"},
        "key_components": {"$ref": "#/$defs/render_label"},
        "assumptions": {"$ref": "#/$defs/render_label"},
        "claims": {"$ref": "#/$defs/render_label"},
        "results": {"$ref": "#/$defs/render_label"},
        "context": {"$ref": "#/$defs/render_label"},
        "evidence": {"$ref": "#/$defs/render_label"},
        "evaluation": {"$ref": "#/$defs/render_label"},
        "datasets": {"$ref": "#/$defs/render_label"},
        "baselines": {"$ref": "#/$defs/render_label"},
        "metrics": {"$ref": "#/$defs/render_label"},
        "ablations": {"$ref": "#/$defs/render_label"},
        "negative_results": {"$ref": "#/$defs/render_label"},
        "limitations": {"$ref": "#/$defs/render_label"},
        "reproducibility": {"$ref": "#/$defs/render_label"},
        "status": {"$ref": "#/$defs/render_label"},
        "available_artifacts": {"$ref": "#/$defs/render_label"},
        "missing_pieces": {"$ref": "#/$defs/render_label"},
        "aidb_assessment": {"$ref": "#/$defs/render_label"},
        "novelty": {"$ref": "#/$defs/render_label"},
        "usefulness": {"$ref": "#/$defs/render_label"},
        "confidence": {"$ref": "#/$defs/render_label"},
        "recommended_action": {"$ref": "#/$defs/render_label"},
        "rationale": {"$ref": "#/$defs/render_label"},
        "uncertainties": {"$ref": "#/$defs/render_label"},
        "open_questions": {"$ref": "#/$defs/render_label"},
        "proposed_experiments": {"$ref": "#/$defs/render_label"},
        "hypothesis": {"$ref": "#/$defs/render_label"},
        "baseline": {"$ref": "#/$defs/render_label"},
        "primary_metric": {"$ref": "#/$defs/render_label"},
        "stop_condition": {"$ref": "#/$defs/render_label"},
        "provenance": {"$ref": "#/$defs/render_label"},
        "schema": {"$ref": "#/$defs/render_label"},
        "profile": {"$ref": "#/$defs/render_label"},
        "provider": {"$ref": "#/$defs/render_label"},
        "generated": {"$ref": "#/$defs/render_label"},
        "document_sha256": {"$ref": "#/$defs/render_label"},
        "metadata_sha256": {"$ref": "#/$defs/render_label"},
        "blocks": {"$ref": "#/$defs/render_label"},
        "repair_count": {"$ref": "#/$defs/render_label"},
        "status_strong": {"$ref": "#/$defs/render_label"},
        "status_partial": {"$ref": "#/$defs/render_label"},
        "status_weak": {"$ref": "#/$defs/render_label"},
        "status_unknown": {"$ref": "#/$defs/render_label"},
        "confidence_high": {"$ref": "#/$defs/render_label"},
        "confidence_medium": {"$ref": "#/$defs/render_label"},
        "confidence_low": {"$ref": "#/$defs/render_label"},
        "action_adopt": {"$ref": "#/$defs/render_label"},
        "action_watch": {"$ref": "#/$defs/render_label"},
        "action_read": {"$ref": "#/$defs/render_label"},
        "action_reject": {"$ref": "#/$defs/render_label"}
      },
      "required": ["executive_summary", "problem", "statement", "importance", "scope", "method", "key_components", "assumptions", "claims", "results", "context", "evidence", "evaluation", "datasets", "baselines", "metrics", "ablations", "negative_results", "limitations", "reproducibility", "status", "available_artifacts", "missing_pieces", "aidb_assessment", "novelty", "usefulness", "confidence", "recommended_action", "rationale", "uncertainties", "open_questions", "proposed_experiments", "hypothesis", "baseline", "primary_metric", "stop_condition", "provenance", "schema", "profile", "provider", "generated", "document_sha256", "metadata_sha256", "blocks", "repair_count", "status_strong", "status_partial", "status_weak", "status_unknown", "confidence_high", "confidence_medium", "confidence_low", "action_adopt", "action_watch", "action_read", "action_reject"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_id": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 400}
      },
      "required": ["block_id", "quote"]
    },
    "evidence_list": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "grounded_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence_list"}
      },
      "required": ["text", "evidence"]
    }
  }
}
